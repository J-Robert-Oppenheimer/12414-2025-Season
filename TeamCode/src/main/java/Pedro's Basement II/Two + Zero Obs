    private PathChain start2Spec5, spec52SubIntake, subIntake2SubDrop, subDrop2MidIntake, midIntake2MidDrop, midDrop2SpecIntake, specIntake2Spec4, spec42Park;

    public void buildPaths() {
        Constants.setConstants(FConstants.class, LConstants.class);
        follower = new Follower(hardwareMap);
        start2Spec5 = follower.pathBuilder()
                .addPath(new BezierLine(new Point(SP.ObsZoneStart), new Point(SP.Specimen5)))
                .setLinearHeadingInterpolation(SP.ObsZoneStart.getHeading(), SP.Specimen5.getHeading())
                .build();

        spec52SubIntake = follower.pathBuilder()
                .addPath(new BezierLine(new Point(SP.Specimen5), new Point(SP.SampleIntakeObsSub)))
                .setLinearHeadingInterpolation(SP.Specimen5.getHeading(), SP.SampleIntakeObsSub.getHeading())
                .build();

        subIntake2SubDrop = follower.pathBuilder()
                .addPath(new BezierLine(new Point(SP.SampleIntakeObsSub), new Point(SP.SampleDropSub)))
                .setLinearHeadingInterpolation(SP.SampleIntakeObsSub.getHeading(), SP.SampleDropSub.getHeading())
                .build();

        subDrop2MidIntake = follower.pathBuilder()
                .addPath(new BezierLine(new Point(SP.SampleDropSub), new Point(SP.SampleIntakeObsMid)))
                .setLinearHeadingInterpolation(SP.SampleDropSub.getHeading(), SP.SampleIntakeObsMid.getHeading())
                .build();

        midIntake2MidDrop = follower.pathBuilder()
                .addPath(new BezierLine(new Point(SP.SampleIntakeObsMid), new Point(SP.SampleDropMid)))
                .setLinearHeadingInterpolation(SP.SampleIntakeObsMid.getHeading(), SP.SampleDropMid.getHeading())
                .build();

        midDrop2SpecIntake = follower.pathBuilder()
                .addPath(new BezierLine(new Point(SP.SampleDropMid), new Point(SP.ObsZoneIntake)))
                .setLinearHeadingInterpolation(SP.SampleDropMid.getHeading(), SP.ObsZoneIntake.getHeading())
                .build();

        specIntake2Spec4 = follower.pathBuilder()
                .addPath(new BezierLine(new Point(SP.ObsZoneIntake), new Point(SP.Specimen4)))
                .setLinearHeadingInterpolation(SP.ObsZoneIntake.getHeading(), SP.Specimen4.getHeading())
                .build();

        spec42Park = follower.pathBuilder()
                .addPath(new BezierCurve(new Point(SP.Specimen4), new Point(65, 137), new Point(SP.ObsPark)))
                .setLinearHeadingInterpolation(SP.Specimen4.getHeading(), SP.ObsPark.getHeading())
                .build();
    }

    public void autonomousPathUpdate() {
        switch (pathState) {
            case 0: // Move from start to scoring position
                gHMap.closeClaw();
                if (!follower.isBusy()) {
                    follower.followPath(start2Spec5);
                    gHMap.armHandler(ArmPos, 3);
                    ArmPos = 3;
                    setPathState(1);
                }
                break;

            case 1:
                gHMap.armHandler(ArmPos, 0);
                ArmPos = 0;
                gHMap.openClaw();
                if (!follower.isBusy()){
                    follower.followPath(spec52SubIntake);
                    gHMap.autoExtend();
                    setPathState(2);
                }
                break;

            case 2:
                gHMap.closeClaw();
                gHMap.armHandler(ArmPos, 2);
                ArmPos = 2;
                if (!follower.isBusy()){
                    follower.followPath(subIntake2SubDrop);
                    gHMap.openClaw();
                    setPathState(3);
                }
                break;

            case 3:
                gHMap.armHandler(ArmPos, 0);
                ArmPos = 0;
                if (!follower.isBusy()){
                    follower.followPath(subDrop2MidIntake);
                    gHMap.autoExtend();
                    setPathState(4);
                }
                break;

            case 4:
                gHMap.closeClaw();
                gHMap.armHandler(ArmPos, 2);
                ArmPos = 2;
                if (!follower.isBusy()){
                    follower.followPath(midIntake2MidDrop);
                    gHMap.openClaw();
                    setPathState(5);
                }
                break;

            case 5:
                if (!follower.isBusy()){
                    follower.followPath(midDrop2SpecIntake);
                    gHMap.closeClaw();
                    gHMap.armHandler(ArmPos, 3);
                    ArmPos = 3;
                    setPathState(6);
                }
                break;

            case 6:
                if (!follower.isBusy()){
                    follower.followPath(specIntake2Spec4);
                    gHMap.armHandler(ArmPos, 0);
                    ArmPos = 0;
                    gHMap.openClaw();
                    setPathState(7);
                }
                break;

            case 7:
                if (!follower.isBusy()){
                    follower.followPath(spec42Park);
                }
                break;
        }
    }